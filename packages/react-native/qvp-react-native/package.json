{
  "name": "@quran.ws/qvp-react-native",
  "version": "0.8.0",
  "description": "React Native wrapper for the QVP vector mushaf engine, for Android and iOS. Thin marshalling over the Kotlin library (JNI over qvp.h) and the Swift library QvpKit.",
  "main": "src/index.tsx",
  "types": "src/index.tsx",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "src",
    "android/build.gradle",
    "android/src",
    "!android/src/test",
    "ios/*.swift",
    "ios/*.m",
    "ios/vendor-qvpkit.sh",
    "ios/vendor/QvpKit",
    "ios/vendor/QvpEngine.json",
    "qvp-react-native.podspec",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bash ios/vendor-qvpkit.sh"
  },
  "keywords": [
    "react-native",
    "quran",
    "mushaf",
    "qvp",
    "vector"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quran-ws/quran-engine.git",
    "directory": "packages/react-native/qvp-react-native"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "typescript": "^5.8.0"
  }
}
